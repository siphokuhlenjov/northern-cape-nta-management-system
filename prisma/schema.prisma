generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  DISTRICT_ADMIN
  PROVINCIAL_OFFICIAL
  SYSTEM_ADMIN
}
enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  DISTRICT_APPROVED
  DISTRICT_REJECTED
  PROVINCIAL_COMPLIANCE_APPROVED
  DISQUALIFIED
}
enum DocumentStatus {
  UPLOADED
  VERIFIED
  RETURNED
  REJECTED
}
enum VettingDecision {
  PENDING
  RETURN
  APPROVE
  DISQUALIFY
}
enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           UserRole @default(TEACHER)
  active         Boolean  @default(true)
  districtId     String?
  district       District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  teacher        Teacher?
  vettingRecords VettingRecord[] @relation("Vetter")
  auditLogs      AuditLog[]
  notifications  Notification[]
  passwordResets PasswordResetToken[]
}

model Teacher {
  id                   String   @id @default(cuid())
  userId               String   @unique
  title                String?
  firstName            String
  surname              String
  saceNumber           String   @unique
  phone                String?
  citizenship          String
  yearsTeaching        Int
  yearsAtCurrentSchool Int
  disabilityInfo       String?
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications         Application[]
  registrationDocuments TeacherRegistrationDocument[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model District {
  id           String        @id @default(cuid())
  name         String        @unique
  schools      School[]
  users        User[]
  applications Application[]
  createdAt    DateTime      @default(now())
}

model School {
  id           String   @id @default(cuid())
  name         String
  emisNumber   String   @unique
  schoolType   String
  quintile     String?
  urbanRural   String?
  districtId   String
  district     District @relation(fields: [districtId], references: [id])
  applications Application[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NtaCategory {
  id            String @id @default(cuid())
  code          String @unique
  name          String @unique
  experienceMin Int    @default(2)
  notes         String?
  active        Boolean @default(true)
  criteria      CategoryCriterion[]
  requirements  CategoryRequirement[]
  cycleRequirements CycleCategoryRequirement[]
  applications  Application[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CategoryCriterion {
  id          String @id @default(cuid())
  categoryId  String
  code        String
  title       String
  description String?
  required    Boolean @default(true)
  category    NtaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  evidence    Evidence[]
  @@unique([categoryId, code])
}

model CategoryRequirement {
  id          String @id @default(cuid())
  categoryId  String
  key         String
  label       String
  description String?
  required    Boolean @default(true)
  category    NtaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([categoryId, key])
}

model Application {
  id                  String @id @default(cuid())
  applicationNumber   String @unique
  teacherId           String
  categoryId          String
  districtId          String
  schoolId            String
  nominationSource    String?
  status              ApplicationStatus @default(DRAFT)
  declarationAccepted Boolean @default(false)
  schoolStampProvided Boolean @default(false)
  submittedAt         DateTime?
  teacher             Teacher @relation(fields: [teacherId], references: [id])
  category            NtaCategory @relation(fields: [categoryId], references: [id])
  district            District @relation(fields: [districtId], references: [id])
  school              School @relation(fields: [schoolId], references: [id])
  documents           Document[]
  evidence            Evidence[]
  vetting             VettingRecord?
  statusHistory       StatusHistory[]
  verificationVisits  VerificationVisit[]
  presentation        Presentation?
  supportTickets      SupportTicket[]
  disputes            Dispute[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cycleId             String?
  profileSnapshot     Json?
  districtDecisionBy  String?
  districtDecisionAt  DateTime?
  provincialDecisionBy String?
  provincialDecisionAt DateTime?
  exportedAt          DateTime?
  cycle               AwardCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  tasks               ReassessmentTask[]
  @@index([status])
  @@index([districtId, status])
  @@index([categoryId])
}

model Document {
  id            String @id @default(cuid())
  applicationId String
  type          String
  fileName      String
  storagePath   String
  mimeType      String
  fileSize      Int
  sha256        String?
  status        DocumentStatus @default(UPLOADED)
  verifiedBy    String?
  verifiedAt    DateTime?
  returnReason  String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  evidence      Evidence[]
  createdAt     DateTime @default(now())
  @@index([applicationId, status])
}

model TeacherRegistrationDocument {
  id          String   @id @default(cuid())
  teacherId   String
  type        String   @default("SACE_CERTIFICATE")
  fileName    String
  storagePath String
  mimeType    String
  fileSize    Int
  sha256      String?
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@index([teacherId, createdAt])
}

model Evidence {
  id            String @id @default(cuid())
  applicationId String
  criterionId   String?
  documentId    String?
  title         String
  description   String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  criterion     CategoryCriterion? @relation(fields: [criterionId], references: [id])
  document      Document? @relation(fields: [documentId], references: [id])
  createdAt     DateTime @default(now())
}

model VettingRecord {
  id                    String @id @default(cuid())
  applicationId         String @unique
  vetterId              String?
  saceChecked           Boolean @default(false)
  qualificationChecked  Boolean @default(false)
  idChecked             Boolean @default(false)
  certificationCurrent  Boolean @default(false)
  experienceChecked     Boolean @default(false)
  serviceTenureYearsVerified Int?
  currentSchoolYearsVerified Int?
  serviceTenureNotes    String?
  schoolVerified        Boolean @default(false)
  documentsComplete     Boolean @default(false)
  previousWinnerChecked Boolean @default(false)
  specialNeedsReviewed  Boolean @default(false)
  decision              VettingDecision @default(PENDING)
  comments              String?
  decidedAt             DateTime?
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vetter                User? @relation("Vetter", fields: [vetterId], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StatusHistory {
  id            String @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  changedBy     String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model VerificationVisit {
  id              String @id @default(cuid())
  applicationId   String
  scheduledAt     DateTime?
  completedAt     DateTime?
  findings        String?
  recommendations String?
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

model Presentation {
  id                  String @id @default(cuid())
  applicationId       String @unique
  fileName            String?
  storagePath         String?
  setupMinutes        Int @default(5)
  durationMinutes     Int @default(35)
  specialArrangements String?
  application         Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SupportTicket {
  id            String @id @default(cuid())
  applicationId String?
  subject       String
  message       String
  status        SupportStatus @default(OPEN)
  response      String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Dispute {
  id            String @id @default(cuid())
  applicationId String
  reason        String
  details       String
  status        DisputeStatus @default(OPEN)
  submittedAt   DateTime @default(now())
  response      String?
  resolvedAt    DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id         String @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}


model AwardCycle {
  id          String   @id @default(cuid())
  name        String   @unique
  year        Int
  status      String   @default("DRAFT")
  opensAt     DateTime?
  closesAt    DateTime?
  guideUrl    String?
  version     Int      @default(1)
  notes       String?
  applications Application[]
  categoryRequirements CycleCategoryRequirement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CycleCategoryRequirement {
  id          String   @id @default(cuid())
  cycleId     String
  categoryId  String
  kind        String
  label       String
  description String?  @db.Text
  required    Boolean  @default(true)
  cycle       AwardCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  category    NtaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([cycleId, categoryId])
}

model ReassessmentTask {
  id            String @id @default(cuid())
  applicationId String
  title         String
  reason        String
  status        String @default("PENDING")
  dueAt         DateTime?
  outcome       String?
  createdBy     String?
  assignedTo    String?
  completedAt   DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([status, dueAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  title     String
  message   String
  readAt    DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}

// Administration and content management
model SiteSetting {
  key String @id
  value String @db.Text
  updatedAt DateTime @updatedAt
}

model ContentPage {
  id String @id @default(cuid())
  slug String @unique
  title String
  summary String? @db.Text
  body String @db.Text
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteEvent {
  id String @id @default(cuid())
  type String
  path String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([type, createdAt])
}


// Password reset: only a SHA-256 hash of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
