DATABASE_URL="postgresql://nta_admin:CHANGE_ME@localhost:5432/nta_northern_cape?schema=public"
SESSION_SECRET="replace-with-a-long-random-secret-before-use"
PORT=3000
NODE_ENV=development
UPLOAD_MAX_MB=10

# Optional AI support assistant. Without a key, built-in guided help is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional override for an OpenAI-compatible chat-completions endpoint
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Public address used in password-reset links. Set to your public HTTPS site URL in production.
# APP_URL=http://localhost:3000
# SMTP mail delivery (required for production password-reset emails).
# Use an app password or provider API/SMTP credential, never your normal mailbox password.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=notifications@example.org
# MAIL_FROM_NAME=Northern Cape NTA
# In development, when SMTP is not configured, the reset link appears only on the reset page.
# RESET_LINK_IN_RESPONSE=false
