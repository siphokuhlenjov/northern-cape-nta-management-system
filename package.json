    "express": "5.1.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "6.19.0"
  }
