{
  "name": "northern-cape-nta-management-system",
  "version": "2.1.0",
  "private": true,
  "description": "Northern Cape National Teaching Awards digital management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
